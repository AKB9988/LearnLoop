<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutLeaderboard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_leaderboard_card"
    android:orientation="horizontal"
    android:padding="16dp"
    android:gravity="bottom|center_horizontal"
    android:layout_marginBottom="16dp">

    <!-- 2nd Place -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:layout_marginTop="24dp">
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/ivPodium2"
            android:layout_width="52dp"
            android:layout_height="52dp"
            app:civ_border_width="2dp"
            app:civ_border_color="@color/podium_silver" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🥈" android:textSize="18sp" android:layout_marginTop="4dp" />
        <TextView
            android:id="@+id/tvPodium2Name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Priya" />
        <TextView
            android:id="@+id/tvPodium2Credits"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            tools:text="980 KC" />
    </LinearLayout>

    <!-- 1st Place -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.2"
        android:gravity="center"
        android:orientation="vertical">
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/ivPodium1"
            android:layout_width="68dp"
            android:layout_height="68dp"
            app:civ_border_width="3dp"
            app:civ_border_color="@color/podium_gold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="👑" android:textSize="22sp" android:layout_marginTop="4dp" />
        <TextView
            android:id="@+id/tvPodium1Name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/gold"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp"
            tools:text="Arjun" />
        <TextView
            android:id="@+id/tvPodium1Credits"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            tools:text="1,250 KC" />
    </LinearLayout>

    <!-- 3rd Place -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:layout_marginTop="36dp">
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/ivPodium3"
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:civ_border_width="2dp"
            app:civ_border_color="@color/podium_bronze" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🥉" android:textSize="16sp" android:layout_marginTop="4dp" />
        <TextView
            android:id="@+id/tvPodium3Name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp"
            tools:text="Rahul" />
        <TextView
            android:id="@+id/tvPodium3Credits"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            tools:text="820 KC" />
    </LinearLayout>
</LinearLayout>
